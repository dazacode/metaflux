# Nothing here is required. A fresh clone works with zero vars.

PORT=8787
HOST=127.0.0.1
METAFLUX_DB=.data/metaflux.sqlite
METAFLUX_CORS=*
METAFLUX_LOG=info

# Offline / air-gapped: serve cache + snapshots only
# METAFLUX_OFFLINE=true

# Politeness knobs
# METAFLUX_HOST_RATE=6
# METAFLUX_HOST_WINDOW_MS=1000
# METAFLUX_HOST_CONCURRENCY=4
# METAFLUX_CONCURRENCY=24
# METAFLUX_TIMEOUT_MS=12000
# METAFLUX_RETRIES=2
# METAFLUX_CONTACT=https://github.com/dazacode/metaflux

# Optional enrichment only
# TMDB_API_KEY=
# COMICVINE_API_KEY=
# TRAKT_CLIENT_ID=
# SPOTIFY_CLIENT_ID=
